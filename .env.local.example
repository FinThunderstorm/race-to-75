# Copy to .env for local development. Startup reads .env, not .env.local.
# The real .env is gitignored. Fill in Withings values only if you want to sync.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/race_to_75
POSTGRES_VERSION=18
PORT=7500
HOST=127.0.0.1
APP_HOST=localhost:7500

# Empty secrets use development defaults through scripts/with-local-env.mjs.
# Never use those defaults in a deployed environment.
JWT_SECRET=
COOKIE_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=race-to-75
WEBAUTHN_ORIGIN=http://localhost:7500
SESSION_TTL_SECONDS=43200
ENROLLMENT_TOKEN_TTL_SECONDS=86400

# Credentials from your Withings developer application.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_API_BASE_URL=https://wbsapi.withings.net
WITHINGS_AUTHORIZE_URL=https://account.withings.com/oauth2_user/authorize2
# Register this exact OAuth redirect URL in the Withings developer dashboard.
WITHINGS_REDIRECT_URI=http://localhost:7500/integrations/withings/callback

# Optional legacy bootstrap connection. Not needed when connecting from /profile.
# Use a long random token if you use the legacy token-based connect URL.
WITHINGS_CONNECT_TOKEN=
# Legacy flow only: app account receiving imported data (not the Withings login).
WITHINGS_BOOTSTRAP_EMAIL=you@example.com
WITHINGS_BOOTSTRAP_DISPLAY_NAME=Your Name
WITHINGS_BOOTSTRAP_ROLE=admin
WITHINGS_INITIAL_SYNC_DAYS=180

# Leave empty for local imports. Reconnect to fetch new readings.
# Automatic notifications require a public callback URL and a running worker.
WITHINGS_WEBHOOK_CALLBACK_URL=
WITHINGS_WORKER_INTERVAL_SECONDS=60
